# Режим окружения. "development" отключает обязательность SERVICE_SECRET
# при старте (см. ниже). Любое другое значение (в т.ч. отсутствие переменной)
# трактуется как production.
ENVIRONMENT=development

# Секрет для аутентификации запросов (заголовок X-Service-Secret).
# Обязателен в production — при его отсутствии сервис не запустится.
# В development можно не задавать.
SERVICE_SECRET=

# Источник справочника городов для автодополнения (GET /geocode/search).
# Пусто / не задано -> справочник недоступен, эндпоинт вернёт 503.
# "postgres" -> использовать PostgresCityRepository (см. city_repository.py).
# Сам расчёт натальной карты (POST /calculate и др.) от этого не зависит —
# если координаты и таймзона переданы явно, справочник не нужен.
CITY_REPOSITORY_SOURCE=

# Строка подключения к PostgreSQL, обязательна если CITY_REPOSITORY_SOURCE=postgres.
# Пример: postgresql://user:password@host:5432/dbname
CITY_REPOSITORY_DSN=
